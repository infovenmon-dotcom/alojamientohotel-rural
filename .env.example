# Kirana — variables de entorno (copiar a .env, NUNCA commitear .env)

# Base de datos (PostgreSQL: Supabase/Neon) — Fase 3+
DATABASE_URL=

# Stripe (pagos). Si STRIPE_SECRET_KEY está definida, la web cobra con Stripe;
# si no, el botón de reserva usa WhatsApp. El webhook registra la reserva.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# % a cobrar al reservar: 100 = pago completo, 30 = señal del 30% (opcional)
DEPOSIT_PCT=100

# Sincronización con Booking.com vía iCal (sin channel manager de pago).
# JSON { "NombreHabitacion": "https://...ical de Booking..." }. También se puede
# configurar desde el panel. La web exporta su iCal en /api/ical/<Habitacion>.ics
BOOKING_ICAL_URLS=

# Email transaccional — Fase 4
EMAIL_API_KEY=
EMAIL_FROM=

# Panel de gestión — contraseña de acceso (Fase 3, stand-in hasta auth real)
PANEL_PASSWORD=cambia-esta-contraseña

# Contacto público
PUBLIC_WHATSAPP=34689352391
PUBLIC_PHONE=+34689352391
