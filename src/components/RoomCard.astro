---
import type { Room } from '@/lib/rooms';
import { bathWord, amenList, roomTag } from '@/lib/rooms';
import { tn, type Lang } from '@/i18n/ui';

interface Props {
  room: Room;
  lang: Lang;
}

const { room, lang } = Astro.props;
const foto = room.fotos[0];
const tag = roomTag(room);
const amenities = amenList(room);
// Reserva provisional vía WhatsApp hasta el motor de reservas (Fase 4).
const bookHref = `https://wa.me/34689352391?text=${encodeURIComponent(
  `Hola, me interesa la habitación ${room.nombre} (${room.concepto}).`
)}`;
---

<article class="group flex flex-col overflow-hidden rounded-2xl border border-paper-2 bg-paper transition-shadow hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden bg-paper-2">
    {foto ? (
      <img
        src={foto}
        alt={`${room.nombre} — ${tn(lang, room.concepto)}`}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full items-center justify-center text-mist/40">
        <span class="font-serif text-4xl">{room.nombre}</span>
      </div>
    )}
    {tag && (
      <span class="absolute left-3 top-3 rounded-full bg-pine/90 px-3 py-1 text-xs text-paper">
        {tn(lang, tag)}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <p class="text-sm text-oak">{tn(lang, room.concepto)}</p>
    <h3 class="mt-1 font-serif text-2xl text-pine">{room.nombre}</h3>
    {room.lema && <p class="mt-1 font-serif text-base italic text-moss">«{tn(lang, room.lema)}»</p>}
    <p class="mt-2 flex-1 text-sm leading-relaxed text-mist">{tn(lang, room.storytelling)}</p>

    <p class="mt-4 text-xs text-mist">
      {room.capacidad} {tn(lang, 'pers')} · ≈{room.m2} m² · {tn(lang, room.cama)} · {tn(lang, bathWord(room))}
    </p>

    <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-mist/80">
      {amenities.map((a) => <li class="rounded-full bg-paper-2 px-2 py-0.5">{tn(lang, a)}</li>)}
    </ul>

    <div class="mt-5 flex items-center justify-between border-t border-paper-2 pt-4">
      <p class="text-ink">
        <span class="text-xs text-mist">{tn(lang, 'desde')} </span>
        <span class="font-serif text-2xl">{room.precio} €</span>
      </p>
      <a
        href={bookHref}
        class="rounded-full border border-pine px-4 py-2 text-sm text-pine transition-colors hover:bg-pine hover:text-paper"
      >
        {tn(lang, 'Reservar →')}
      </a>
    </div>
  </div>
</article>
