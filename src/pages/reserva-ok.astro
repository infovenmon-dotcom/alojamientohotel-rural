---
export const prerender = false;
import Stripe from 'stripe';

const id = Astro.url.searchParams.get('session_id');
let room = '', inS = '', outS = '', ok = false;
const key = process.env.STRIPE_SECRET_KEY;
if (id && key) {
  try {
    const s = await new Stripe(key).checkout.sessions.retrieve(id);
    ok = s.payment_status === 'paid';
    room = s.metadata?.room || '';
    inS = s.metadata?.in || '';
    outS = s.metadata?.out || '';
  } catch {
    /* sesión no válida */
  }
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reserva confirmada · Kirana</title>
    <meta name="robots" content="noindex" />
    <style>
      body{margin:0;font-family:system-ui,sans-serif;background:#F4F5F0;color:#1E211B;display:flex;min-height:100vh;align-items:center;justify-content:center;padding:24px}
      .card{background:#fff;border:1px solid #E2E5DA;border-radius:16px;max-width:480px;width:100%;padding:40px;text-align:center;box-shadow:0 20px 50px rgba(30,33,27,.1)}
      h1{font-family:Georgia,serif;font-weight:400;color:#2B3A2E;font-size:1.9rem;margin:.2em 0 .4em}
      .tick{width:64px;height:64px;border-radius:50%;background:#5F6E52;color:#fff;display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 18px}
      p{color:#5b5f54;line-height:1.6}
      .det{background:#F4F5F0;border-radius:10px;padding:16px;margin:18px 0;font-size:.95rem}
      a{display:inline-block;margin-top:10px;background:#2B3A2E;color:#fff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:600}
    </style>
  </head>
  <body>
    <div class="card">
      {ok ? (
        <>
          <div class="tick">✓</div>
          <h1>¡Reserva confirmada!</h1>
          <p>Gracias por reservar en Kirana. Te hemos enviado el comprobante por email.</p>
          {room && (
            <div class="det"><b>{room}</b><br />{inS} → {outS}</div>
          )}
          <p>Si necesitas cualquier cosa, escríbenos a <a href="mailto:hola@kiranabermeo.es" style="background:none;color:#5F6E52;padding:0;font-weight:600">hola@kiranabermeo.es</a>.</p>
        </>
      ) : (
        <>
          <h1>Estamos confirmando tu pago…</h1>
          <p>Si has completado el pago, recibirás la confirmación en breve. Si no, vuelve a intentarlo o escríbenos.</p>
        </>
      )}
      <a href="/">Volver a Kirana</a>
    </div>
  </body>
</html>
