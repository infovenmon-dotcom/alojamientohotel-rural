---
import PanelLayout from '@/layouts/PanelLayout.astro';
import sample from '@/data/panel-sample.json';

const invoices = sample.invoices;
const euro = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const total = invoices.reduce((s, i) => s + i.base + i.iva, 0);
const pendiente = invoices.filter((i) => i.status === 'Pendiente').reduce((s, i) => s + i.base + i.iva, 0);
---

<PanelLayout title="Facturas" subtitle="Datos de ejemplo. La firma y el envío TicketBAI/Batuz NO se reimplementan: se integra software homologado (regla #3)." active="facturas">
  <div class="mb-8 rounded-2xl border border-oak/40 bg-oak/5 p-5">
    <p class="text-sm font-medium uppercase tracking-[0.15em] text-oak">TicketBAI · Batuz · Bizkaia</p>
    <p class="mt-2 max-w-3xl text-sm text-mist">
      Facturación obligatoria en Bizkaia desde el 1 de enero de 2026: factura con código TBAI + QR,
      firmada y encadenada, envío telemático y LROE (modelo 140 autónomos / 240 empresas) vía Bizkaibai.
      Requiere <strong>software garante homologado + certificado digital</strong>, o la app oficial
      <a class="underline" href="https://batuz.eus/haztufactura">batuz.eus/haztufactura</a>.
      Esta firma <strong>no se reimplementa a mano</strong> (Fase 6).
    </p>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-paper-2 bg-paper p-5"><p class="text-sm text-mist">Facturas emitidas</p><p class="mt-1 font-serif text-3xl text-pine">{invoices.length}</p></div>
    <div class="rounded-2xl border border-paper-2 bg-paper p-5"><p class="text-sm text-mist">Total (IVA incl.)</p><p class="mt-1 font-serif text-3xl text-pine">{euro(total)}</p></div>
    <div class="rounded-2xl border border-paper-2 bg-paper p-5"><p class="text-sm text-mist">Pendiente de cobro</p><p class="mt-1 font-serif text-3xl text-pine">{euro(pendiente)}</p></div>
  </div>

  <section class="mt-8 overflow-x-auto rounded-2xl border border-paper-2 bg-paper">
    <table class="w-full text-sm">
      <thead class="text-left text-mist">
        <tr class="border-b border-paper-2">
          <th class="px-4 py-3 font-medium">Nº</th>
          <th class="px-4 py-3 font-medium">Fecha</th>
          <th class="px-4 py-3 font-medium">Cliente</th>
          <th class="px-4 py-3 font-medium">Concepto</th>
          <th class="px-4 py-3 font-medium">Base</th>
          <th class="px-4 py-3 font-medium">IVA</th>
          <th class="px-4 py-3 font-medium">Total</th>
          <th class="px-4 py-3 font-medium">Estado</th>
        </tr>
      </thead>
      <tbody>
        {invoices.map((i) => (
          <tr class="border-b border-paper-2 last:border-0">
            <td class="px-4 py-3 font-mono text-xs text-ink">{i.n}</td>
            <td class="px-4 py-3 text-mist">{i.date}</td>
            <td class="px-4 py-3 text-ink">{i.client}</td>
            <td class="px-4 py-3 text-mist">{i.concept}</td>
            <td class="px-4 py-3 text-mist">{euro(i.base)}</td>
            <td class="px-4 py-3 text-mist">{euro(i.iva)}</td>
            <td class="px-4 py-3 text-ink">{euro(i.base + i.iva)}</td>
            <td class="px-4 py-3">
              <span class:list={['rounded-full px-2 py-0.5 text-xs', i.status === 'Cobrada' ? 'bg-moss/15 text-moss' : 'bg-oak/15 text-oak']}>{i.status}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</PanelLayout>
