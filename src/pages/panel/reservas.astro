---
import PanelLayout from '@/layouts/PanelLayout.astro';
import { getActiveRooms } from '@/lib/rooms';
import sample from '@/data/panel-sample.json';

type Booking = (typeof sample.bookings)[number];
const bookings = sample.bookings as Booking[];
const channelColors = sample.channelColors as Record<string, string>;

const rooms = getActiveRooms();
const activeNames = new Set(rooms.map((r) => r.nombre));

// Mes mostrado (?ym=YYYY-MM), por defecto el actual.
const now = new Date();
const ymParam = Astro.url.searchParams.get('ym');
const [yy, mm] = ymParam && /^\d{4}-\d{2}$/.test(ymParam)
  ? ymParam.split('-').map(Number)
  : [now.getFullYear(), now.getMonth() + 1];
const monthStart = new Date(yy, mm - 1, 1);
const daysInMonth = new Date(yy, mm, 0).getDate();
const MES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const pad = (n: number) => String(n).padStart(2, '0');
const prevYm = mm === 1 ? `${yy - 1}-12` : `${yy}-${pad(mm - 1)}`;
const nextYm = mm === 12 ? `${yy + 1}-01` : `${yy}-${pad(mm + 1)}`;

const todayStr = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

// ¿La habitación `room` está ocupada el día `dateStr`? [in, out)
function occupiedBy(room: string, dateStr: string): Booking | undefined {
  return bookings.find((b) => b.room === room && b.in <= dateStr && dateStr < b.out);
}

// KPIs de hoy
const entradasHoy = bookings.filter((b) => b.in === todayStr).length;
const salidasHoy = bookings.filter((b) => b.out === todayStr).length;
const ocupadasHoy = rooms.filter((r) => occupiedBy(r.nombre, todayStr)).length;
const ocupacion = rooms.length ? Math.round((ocupadasHoy / rooms.length) * 100) : 0;

const proximas = [...bookings].sort((a, b) => a.in.localeCompare(b.in));
const days = Array.from({ length: daysInMonth }, (_, i) => i + 1);

const kpis = [
  { label: 'Entradas hoy', value: entradasHoy },
  { label: 'Salidas hoy', value: salidasHoy },
  { label: 'Ocupación hoy', value: `${ocupacion}%` },
  { label: 'Reservas en agenda', value: bookings.length },
];
---

<PanelLayout title="Reservas" subtitle="Canales conectados · sincronizados (Web · Booking · Expedia/Vrbo). Datos de ejemplo hasta el motor de reservas (Fase 4)." active="reservas">
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    {kpis.map((k) => (
      <div class="rounded-2xl border border-paper-2 bg-paper p-5">
        <p class="text-sm text-mist">{k.label}</p>
        <p class="mt-1 font-serif text-3xl text-pine">{k.value}</p>
      </div>
    ))}
  </div>

  <section class="mt-8 rounded-2xl border border-paper-2 bg-paper p-5">
    <div class="mb-4 flex items-center justify-between">
      <h3 class="font-serif text-xl text-pine">Calendario · {MES[mm - 1]} {yy}</h3>
      <div class="flex gap-2 text-sm">
        <a href={`?ym=${prevYm}`} class="rounded-full border border-paper-2 px-3 py-1 text-mist hover:bg-paper-2">←</a>
        <a href={`?ym=${nextYm}`} class="rounded-full border border-paper-2 px-3 py-1 text-mist hover:bg-paper-2">→</a>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-xs">
        <thead>
          <tr>
            <th class="sticky left-0 bg-paper px-2 py-1 text-left font-medium text-mist">Habitación</th>
            {days.map((d) => <th class="w-6 px-0 py-1 text-center font-normal text-mist/60">{d}</th>)}
          </tr>
        </thead>
        <tbody>
          {rooms.map((r) => (
            <tr class="border-t border-paper-2">
              <td class="sticky left-0 bg-paper px-2 py-1 font-medium text-ink">{r.nombre}</td>
              {days.map((d) => {
                const dateStr = `${yy}-${pad(mm)}-${pad(d)}`;
                const b = occupiedBy(r.nombre, dateStr);
                const isToday = dateStr === todayStr;
                return (
                  <td class="px-0 py-1 text-center">
                    <div
                      title={b ? `${b.name} · ${b.ch}` : ''}
                      class:list={['mx-auto h-4 w-5 rounded-sm', isToday && !b ? 'ring-1 ring-oak' : '']}
                      style={b ? `background:${channelColors[b.ch] ?? '#5F6E52'}` : 'background:#E7E9E0'}
                    ></div>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex flex-wrap gap-4 text-xs text-mist">
      {Object.entries(channelColors).map(([ch, color]) => (
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm" style={`background:${color}`}></span>{ch}</span>
      ))}
    </div>
  </section>

  <section class="mt-8">
    <h3 class="mb-4 font-serif text-xl text-pine">Próximas reservas</h3>
    <div class="overflow-x-auto rounded-2xl border border-paper-2 bg-paper">
      <table class="w-full text-sm">
        <thead class="text-left text-mist">
          <tr class="border-b border-paper-2">
            <th class="px-4 py-3 font-medium">Habitación</th>
            <th class="px-4 py-3 font-medium">Huésped</th>
            <th class="px-4 py-3 font-medium">Entrada</th>
            <th class="px-4 py-3 font-medium">Salida</th>
            <th class="px-4 py-3 font-medium">Pax</th>
            <th class="px-4 py-3 font-medium">Canal</th>
            <th class="px-4 py-3 font-medium">€/noche</th>
          </tr>
        </thead>
        <tbody>
          {proximas.map((b) => (
            <tr class="border-b border-paper-2 last:border-0">
              <td class="px-4 py-3">
                {b.room}
                {!activeNames.has(b.room) && <span class="ml-1 text-xs text-[#A6543E]">(bloqueada)</span>}
                {b.mp && <span class="ml-1 rounded-full bg-paper-2 px-2 py-0.5 text-xs text-mist">MP</span>}
              </td>
              <td class="px-4 py-3 text-ink">{b.name}</td>
              <td class="px-4 py-3 text-mist">{b.in}</td>
              <td class="px-4 py-3 text-mist">{b.out}</td>
              <td class="px-4 py-3 text-mist">{b.guests}</td>
              <td class="px-4 py-3">
                <span class="rounded-full px-2 py-0.5 text-xs text-paper" style={`background:${channelColors[b.ch] ?? '#5F6E52'}`}>{b.ch}</span>
              </td>
              <td class="px-4 py-3 text-mist">{b.rate} €</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</PanelLayout>
