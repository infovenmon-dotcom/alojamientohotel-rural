---
import PanelLayout from '@/layouts/PanelLayout.astro';
import sample from '@/data/panel-sample.json';

type Booking = (typeof sample.bookings)[number];
const bookings = sample.bookings as Booking[];
const invoices = sample.invoices;
const channelColors = sample.channelColors as Record<string, string>;

const euro = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const nights = (b: Booking) => Math.max(1, Math.round((Date.parse(b.out) - Date.parse(b.in)) / 86400000));

// Ingresos facturados por mes (de facturas)
const porMes = new Map<string, number>();
for (const inv of invoices) {
  const ym = inv.date.slice(0, 7);
  porMes.set(ym, (porMes.get(ym) ?? 0) + inv.base + inv.iva);
}

// Ingresos estimados por habitación y por canal (de reservas)
const porHab = new Map<string, number>();
const porCanal = new Map<string, number>();
for (const b of bookings) {
  const rev = nights(b) * b.rate;
  porHab.set(b.room, (porHab.get(b.room) ?? 0) + rev);
  porCanal.set(b.ch, (porCanal.get(b.ch) ?? 0) + rev);
}
const habRows = [...porHab.entries()].sort((a, b) => b[1] - a[1]);
const canalRows = [...porCanal.entries()].sort((a, b) => b[1] - a[1]);
const habMax = Math.max(...habRows.map(([, v]) => v), 1);
const canalTotal = canalRows.reduce((s, [, v]) => s + v, 0);
const totalFacturado = [...porMes.values()].reduce((s, v) => s + v, 0);
---

<PanelLayout title="Ingresos" subtitle="Estimaciones a partir de datos de ejemplo (Fase 4). El IVA está incluido en las tarifas." active="ingresos">
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-paper-2 bg-paper p-5">
      <p class="text-sm text-mist">Facturado (junio)</p>
      <p class="mt-1 font-serif text-3xl text-pine">{euro(totalFacturado)}</p>
    </div>
    <div class="rounded-2xl border border-paper-2 bg-paper p-5">
      <p class="text-sm text-mist">Reservas</p>
      <p class="mt-1 font-serif text-3xl text-pine">{bookings.length}</p>
    </div>
    <div class="rounded-2xl border border-paper-2 bg-paper p-5">
      <p class="text-sm text-mist">Ingreso estimado en reservas</p>
      <p class="mt-1 font-serif text-3xl text-pine">{euro(canalTotal)}</p>
    </div>
  </div>

  <section class="mt-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-paper-2 bg-paper p-5">
      <h3 class="mb-4 font-serif text-xl text-pine">Ingresos por habitación</h3>
      <ul class="space-y-3">
        {habRows.map(([room, v]) => (
          <li>
            <div class="flex justify-between text-sm"><span class="text-ink">{room}</span><span class="text-mist">{euro(v)}</span></div>
            <div class="mt-1 h-2 rounded-full bg-paper-2">
              <div class="h-2 rounded-full bg-moss" style={`width:${(v / habMax) * 100}%`}></div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-2xl border border-paper-2 bg-paper p-5">
      <h3 class="mb-4 font-serif text-xl text-pine">Ingresos por canal</h3>
      <ul class="space-y-3">
        {canalRows.map(([ch, v]) => (
          <li>
            <div class="flex justify-between text-sm">
              <span class="flex items-center gap-2 text-ink"><span class="h-3 w-3 rounded-sm" style={`background:${channelColors[ch] ?? '#5F6E52'}`}></span>{ch}</span>
              <span class="text-mist">{euro(v)} · {Math.round((v / canalTotal) * 100)}%</span>
            </div>
            <div class="mt-1 h-2 rounded-full bg-paper-2">
              <div class="h-2 rounded-full" style={`width:${(v / canalTotal) * 100}%;background:${channelColors[ch] ?? '#5F6E52'}`}></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PanelLayout>
