---
import PanelLayout from '@/layouts/PanelLayout.astro';
import sample from '@/data/panel-sample.json';

const invoices = sample.invoices;
const expenses = sample.expenses;
const catColors = sample.catColors as Record<string, string>;
const euro = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

// Movimientos: ingresos (facturas) + gastos
type Mov = { date: string; desc: string; type: 'Ingreso' | 'Gasto'; amount: number };
const movs: Mov[] = [
  ...invoices.map((i) => ({ date: i.date, desc: `${i.client} · ${i.concept}`, type: 'Ingreso' as const, amount: i.base + i.iva })),
  ...expenses.map((e) => ({ date: e.date, desc: `${e.desc} · ${e.cat}`, type: 'Gasto' as const, amount: -e.amt })),
].sort((a, b) => b.date.localeCompare(a.date));

// Gastos por categoría
const porCat = new Map<string, number>();
for (const e of expenses) porCat.set(e.cat, (porCat.get(e.cat) ?? 0) + e.amt);
const catRows = [...porCat.entries()].sort((a, b) => b[1] - a[1]);
const catTotal = catRows.reduce((s, [, v]) => s + v, 0);

// Resumen trimestre (simplificado, datos de ejemplo)
const ingresosBase = invoices.reduce((s, i) => s + i.base, 0);
const ivaRepercutido = invoices.reduce((s, i) => s + i.iva, 0);
const gastos = expenses.reduce((s, e) => s + e.amt, 0);
const beneficio = ingresosBase - gastos;
---

<PanelLayout title="Contabilidad" subtitle="Resumen orientativo con datos de ejemplo. La contabilidad y los modelos oficiales se integran en Fase 6 (no se calculan impuestos reales aquí)." active="contabilidad">
  <div class="grid gap-4 sm:grid-cols-4">
    <div class="rounded-2xl border border-paper-2 bg-paper p-5"><p class="text-sm text-mist">Ingresos (base)</p><p class="mt-1 font-serif text-2xl text-pine">{euro(ingresosBase)}</p></div>
    <div class="rounded-2xl border border-paper-2 bg-paper p-5"><p class="text-sm text-mist">IVA repercutido</p><p class="mt-1 font-serif text-2xl text-pine">{euro(ivaRepercutido)}</p></div>
    <div class="rounded-2xl border border-paper-2 bg-paper p-5"><p class="text-sm text-mist">Gastos</p><p class="mt-1 font-serif text-2xl text-pine">{euro(gastos)}</p></div>
    <div class="rounded-2xl border border-paper-2 bg-paper p-5"><p class="text-sm text-mist">Beneficio (aprox.)</p><p class="mt-1 font-serif text-2xl text-pine">{euro(beneficio)}</p></div>
  </div>

  <section class="mt-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-paper-2 bg-paper p-5">
      <h3 class="mb-4 font-serif text-xl text-pine">Gastos por categoría</h3>
      <ul class="space-y-3">
        {catRows.map(([cat, v]) => (
          <li>
            <div class="flex justify-between text-sm">
              <span class="flex items-center gap-2 text-ink"><span class="h-3 w-3 rounded-sm" style={`background:${catColors[cat] ?? '#9AA08F'}`}></span>{cat}</span>
              <span class="text-mist">{euro(v)}</span>
            </div>
            <div class="mt-1 h-2 rounded-full bg-paper-2">
              <div class="h-2 rounded-full" style={`width:${(v / catTotal) * 100}%;background:${catColors[cat] ?? '#9AA08F'}`}></div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-2xl border border-paper-2 bg-paper p-5">
      <h3 class="mb-4 font-serif text-xl text-pine">Movimientos recientes</h3>
      <ul class="divide-y divide-paper-2 text-sm">
        {movs.map((m) => (
          <li class="flex items-center justify-between gap-3 py-2">
            <div>
              <p class="text-ink">{m.desc}</p>
              <p class="text-xs text-mist">{m.date}</p>
            </div>
            <span class:list={['shrink-0 font-medium', m.amount >= 0 ? 'text-moss' : 'text-[#A6543E]']}>
              {m.amount >= 0 ? '+' : '−'}{euro(Math.abs(m.amount))}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PanelLayout>
