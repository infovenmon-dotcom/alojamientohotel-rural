---
import PanelLayout from '@/layouts/PanelLayout.astro';
import { getAllRooms, bathWord } from '@/lib/rooms';

const rooms = getAllRooms();
const activas = rooms.filter((r) => r.activa).length;
const total = rooms.length;

const plantas = [
  { key: 'superior', label: 'Planta superior' },
  { key: 'baja', label: 'Planta baja' },
] as const;

const error = Astro.url.searchParams.get('error');
---

<PanelLayout
  title="Habitaciones"
  subtitle={`${activas} de ${total} en uso. Bloquear una habitación la oculta de la web, el calendario y las reservas (regla #2).`}
  active="habitaciones"
>
  {error && (
    <div class="mb-6 rounded-xl border border-[#A6543E]/40 bg-[#A6543E]/5 p-4 text-sm text-[#A6543E]">
      {error}
    </div>
  )}

  {plantas.map((planta) => {
    const list = rooms.filter((r) => r.planta === planta.key);
    if (list.length === 0) return null;
    return (
      <section class="mb-10">
        <h2 class="mb-4 text-sm uppercase tracking-[0.2em] text-oak">{planta.label}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((room) => (
            <article
              class:list={[
                'flex flex-col rounded-2xl border bg-paper p-5',
                room.activa ? 'border-paper-2' : 'border-dashed border-mist/40 opacity-70',
              ]}
            >
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="font-serif text-xl text-pine">
                    {room.nombre}
                    {room.tipo === 'accesible' && <span title="Accesible" aria-label="Accesible"> ♿</span>}
                  </h3>
                  <p class="text-xs text-mist">{room.significado} · {room.concepto}</p>
                </div>
                <span
                  class:list={[
                    'shrink-0 rounded-full px-2.5 py-1 text-xs',
                    room.activa ? 'bg-moss/15 text-moss' : 'bg-mist/15 text-mist',
                  ]}
                >
                  {room.activa ? 'Activa' : 'Bloqueada'}
                </span>
              </div>

              <p class="mt-3 flex-1 text-sm text-mist">{room.storytelling}</p>

              <p class="mt-3 text-xs text-mist">
                {room.capacidad} pers · ≈{room.m2} m² · {room.cama} · {bathWord(room)} · {room.precio} €
              </p>

              <form method="POST" action={`/api/rooms/${room.id}`} class="mt-4">
                <input type="hidden" name="activa" value={room.activa ? 'false' : 'true'} />
                <button
                  type="submit"
                  class:list={[
                    'w-full rounded-full px-4 py-2 text-sm transition-colors',
                    room.activa
                      ? 'border border-mist/40 text-mist hover:bg-mist/10'
                      : 'bg-pine text-paper hover:opacity-90',
                  ]}
                >
                  {room.activa ? 'Bloquear' : 'Activar'}
                </button>
              </form>
            </article>
          ))}
        </div>
      </section>
    );
  })}

  <p class="text-xs text-mist/70">
    Los cambios se guardan en <code>src/data/rooms.json</code> (fuente única) y se reflejan en la web
    pública en la siguiente carga. En producción, esta persistencia pasará a la base de datos.
  </p>
</PanelLayout>
