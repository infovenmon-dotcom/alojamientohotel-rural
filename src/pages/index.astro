// Web pública: servimos la maqueta definitiva de Kirana (src/home.html) tal cual
// — es autocontenida (CSS/JS/i18n en línea, imágenes en CDN). El panel sigue en
// /panel (SSR). Las habitaciones de esta home son su propio contenido; conectar
// el bloqueo del panel a esta web (regla #2) es el siguiente paso.
export const prerender = false;
import html from '../home.html?raw';

return new Response(html, {
  headers: { 'content-type': 'text/html; charset=utf-8' },
});
