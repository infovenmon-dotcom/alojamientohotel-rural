---
// La maqueta cambia de idioma en cliente: servimos la MISMA home para cualquier
// locale válido (/eu, /fr…) con la misma inyección de disponibilidad. ES = raíz.
export const prerender = false;
import html from '../../home.html?raw';
import { languages, defaultLang } from '@/i18n/ui';
import { getActiveRooms } from '@/lib/rooms';
import sample from '@/data/panel-sample.json';

const param = Astro.params.lang;
if (!param || !(param in languages) || param === defaultLang) {
  return new Response('Not found', { status: 404 });
}

let out = html;
try {
  const activeNames = (await getActiveRooms()).map((r) => r.nombre);
  const booked: Record<string, [string, string][]> = {};
  for (const b of sample.bookings as { room: string; in: string; out: string }[]) {
    (booked[b.room] ??= []).push([b.in, b.out]);
  }
  const json = JSON.stringify({ activeNames, booked }).replace(/</g, '\\u003c');
  out = html.replace('<!--KIRANA_AVAIL-->', `<script>window.KIRANA_AVAIL=${json}</script>`);
} catch {
  /* se sirve la maqueta tal cual */
}

return new Response(out, {
  headers: { 'content-type': 'text/html; charset=utf-8' },
});
---
