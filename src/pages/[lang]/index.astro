---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SeccionCasa from '@/components/SeccionCasa.astro';
import SeccionEspacios from '@/components/SeccionEspacios.astro';
import SeccionIdea from '@/components/SeccionIdea.astro';
import RoomsSection from '@/components/RoomsSection.astro';
import SeccionServicios from '@/components/SeccionServicios.astro';
import Banda from '@/components/Banda.astro';
import SeccionEntorno from '@/components/SeccionEntorno.astro';
import SeccionActividades from '@/components/SeccionActividades.astro';
import SeccionEstancia from '@/components/SeccionEstancia.astro';
import SeccionOpiniones from '@/components/SeccionOpiniones.astro';
import SeccionOfertas from '@/components/SeccionOfertas.astro';
import SeccionReserva from '@/components/SeccionReserva.astro';
import { languages, defaultLang, type Lang } from '@/i18n/ui';

// Una página por idioma (ES vive en la raíz). getStaticPaths permite servir la
// web pública también como estática (GitHub Pages).
export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <SeccionCasa lang={lang} />
  <SeccionEspacios lang={lang} />
  <SeccionIdea lang={lang} />
  <RoomsSection lang={lang} />
  <SeccionServicios lang={lang} />
  <Banda lang={lang} />
  <SeccionEntorno lang={lang} />
  <SeccionActividades lang={lang} />
  <SeccionEstancia lang={lang} />
  <SeccionOpiniones lang={lang} />
  <SeccionOfertas lang={lang} />
  <SeccionReserva lang={lang} />
</BaseLayout>
