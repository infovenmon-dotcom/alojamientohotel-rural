---
import '@/styles/global.css';

interface Props {
  title: string;
  subtitle?: string;
  active: 'reservas' | 'ingresos' | 'habitaciones' | 'facturas' | 'contabilidad';
}

const { title, subtitle, active } = Astro.props;

const nav = [
  { key: 'reservas', label: 'Reservas', href: '/panel/reservas' },
  { key: 'ingresos', label: 'Ingresos', href: '/panel/ingresos' },
  { key: 'habitaciones', label: 'Habitaciones', href: '/panel/habitaciones' },
  { key: 'facturas', label: 'Facturas', href: '/panel/facturas' },
  { key: 'contabilidad', label: 'Contabilidad', href: '/panel/contabilidad' },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Panel Kirana</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Hanken+Grotesk:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-paper-2/40">
    <div class="flex min-h-screen flex-col md:flex-row">
      <aside class="shrink-0 border-b border-paper-2 bg-paper md:w-60 md:border-b-0 md:border-r">
        <div class="flex items-center justify-between px-5 py-5 md:block">
          <div>
            <p class="font-serif text-2xl text-pine">Kirana</p>
            <p class="text-xs text-mist">Panel de gestión</p>
          </div>
        </div>
        <nav class="flex gap-1 overflow-x-auto px-3 pb-3 md:flex-col md:px-3">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={[
                'whitespace-nowrap rounded-lg px-3 py-2 text-sm transition-colors',
                active === n.key ? 'bg-pine text-paper' : 'text-mist hover:bg-paper-2',
              ]}
            >
              {n.label}
            </a>
          ))}
        </nav>
        <div class="hidden px-3 md:mt-auto md:block">
          <a href="/" class="block rounded-lg px-3 py-2 text-sm text-mist hover:bg-paper-2">← Ver la web</a>
          <form method="POST" action="/panel/logout">
            <button type="submit" class="w-full rounded-lg px-3 py-2 text-left text-sm text-mist hover:bg-paper-2">
              Cerrar sesión
            </button>
          </form>
        </div>
      </aside>

      <main class="flex-1 px-5 py-8 md:px-10">
        <header class="mb-8">
          <h1 class="font-serif text-3xl text-pine">{title}</h1>
          {subtitle && <p class="mt-1 text-mist">{subtitle}</p>}
        </header>
        <slot />
      </main>
    </div>
  </body>
</html>
